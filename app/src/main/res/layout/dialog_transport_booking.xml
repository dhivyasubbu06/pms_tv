<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_main"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvFormTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Airport pickup"
        android:textColor="@color/gold_accent"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvGuestInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Room 205 - Dhivya S"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFormTitle" />

    <!-- Compact Dynamic Fields -->
    <LinearLayout
        android:id="@+id/llDynamicFields"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tvGuestInfo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Field 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvField1Label"
                    style="@style/TransportFieldLabel"
                    android:layout_marginTop="4dp"
                    android:text="DATE &amp; TIME" />
                <LinearLayout
                    android:id="@+id/llField1"
                    style="@style/TransportFieldInputGroup"
                    android:layout_marginTop="3dp"
                    android:padding="8dp">
                    <TextView
                        android:id="@+id/tvField1Value"
                        style="@style/TransportFieldInputValue"
                        android:text="28 Aug 09:40 AM"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Field 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvField2Label"
                    style="@style/TransportFieldLabel"
                    android:layout_marginTop="4dp"
                    android:text="AIRLINE / DEST" />
                <LinearLayout
                    android:id="@+id/llField2"
                    style="@style/TransportFieldInputGroup"
                    android:layout_marginTop="3dp"
                    android:padding="8dp">
                    <TextView
                        android:id="@+id/tvField2Value"
                        style="@style/TransportFieldInputValue"
                        android:text="IndiGo"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Field 3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvField3Label"
                    style="@style/TransportFieldLabel"
                    android:layout_marginTop="4dp"
                    android:text="PASSENGERS" />
                <LinearLayout
                    android:id="@+id/llField3"
                    style="@style/TransportFieldInputGroup"
                    android:layout_marginTop="3dp"
                    android:padding="8dp">
                    <TextView
                        android:id="@+id/tvField3Value"
                        style="@style/TransportFieldInputValue"
                        android:gravity="center"
                        android:text="2"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Field 4 -->
            <LinearLayout
                android:id="@+id/llField4Container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvField4Label"
                    style="@style/TransportFieldLabel"
                    android:layout_marginTop="4dp"
                    android:text="BAGS" />
                <LinearLayout
                    android:id="@+id/llField4"
                    style="@style/TransportFieldInputGroup"
                    android:layout_marginTop="3dp"
                    android:padding="8dp">
                    <TextView
                        android:id="@+id/tvField4Value"
                        style="@style/TransportFieldInputValue"
                        android:gravity="center"
                        android:text="3"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <EditText
            android:id="@+id/etOptionalField"
            style="@style/TransportFieldEditText"
            android:layout_marginTop="8dp"
            android:minHeight="40dp"
            android:padding="8dp"
            android:textSize="13sp"
            android:hint="Optional: Flight No / Note" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:text="Confirm booking"
        android:textColor="@color/burgundy_text"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/gold_accent"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/llDynamicFields" />

</androidx.constraintlayout.widget.ConstraintLayout>
