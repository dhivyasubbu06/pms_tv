<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected/Focused state: Solid gold fill -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gold_accent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gold_accent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Default state: Outlined pill (dark background) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/wine_dark" />
            <stroke android:width="1dp" android:color="@color/gold_dim" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
