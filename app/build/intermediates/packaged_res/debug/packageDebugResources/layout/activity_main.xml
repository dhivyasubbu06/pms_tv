<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_wine_gradient"
    android:paddingStart="32dp"
    android:paddingTop="8dp"
    android:paddingEnd="32dp"
    android:paddingBottom="24dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ======================= TOP BAR ======================= -->

    <!-- Top Left: circle logo + hotel name -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/brandGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/logoCrown"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_crown_logo"
            app:layout_constraintStart_toStartOf="@id/logoCircle"
            app:layout_constraintEnd_toEndOf="@id/logoCircle"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/gold_accent" />

        <FrameLayout
            android:id="@+id/logoCircle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_logo_circle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/logoCrown">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="serif"
                android:text="PH"
                android:textColor="@color/gold_accent"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/logoCircle"
            app:layout_constraintStart_toEndOf="@id/logoCircle"
            app:layout_constraintTop_toTopOf="@id/logoCircle">

            <TextView
                android:id="@+id/hotelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:letterSpacing="0.1"
                android:text="@string/hotel_name"
                android:textAllCaps="true"
                android:textColor="@color/gold_accent"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hotelTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.25"
                android:text="@string/hotel_tagline"
                android:textAllCaps="true"
                android:textColor="@color/gold_accent"
                android:textSize="8sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/clockGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/gold_accent"
            android:textSize="40sp"
            tools:text="20:41" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:textAllCaps="true"
            android:textColor="@color/gold_accent"
            android:textSize="14sp"
            tools:text="MONDAY, 10 AUG" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wifiCard"
        android:layout_width="210dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_wifi_card_pink"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_wifi_small"
            app:tint="@color/gold_accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMPLIMENTARY WIFI"
                android:textAllCaps="true"
                android:textColor="@color/gold_accent"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/wifiNetworkName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Pine_Hotel_Guest"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/wifiTapLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_wifi_tap_pink"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="TAP"
            android:textAllCaps="true"
            android:textColor="@color/gold_accent"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- ======================= WELCOME & TAGLINE ======================= -->

    <LinearLayout
        android:id="@+id/welcomeGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/brandGroup">

        <TextView
            android:id="@+id/tvWelcomeGuest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="Welcome, Guest"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRoomNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_solid_pink"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                tools:text="Room 205" />

            <TextView
                android:id="@+id/welcomeMessageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="We wish you a pleasant stay!"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="serif"
            android:text="Relax. Unwind. We are here for you."
            android:textColor="@color/gold_accent"
            android:textSize="13sp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- TODAY'S EXPERIENCES Panel -->
    <LinearLayout
        android:id="@+id/experiencesPanel"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/wifiCard">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:paddingBottom="4dp"
            android:text="TODAY'S EXPERIENCES"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_info_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_bell_small"
                app:tint="@color/rose_pink" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/experiencesEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="No experiences scheduled today."
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/experiencesEmptySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Enjoy your time with us!"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ======================= 9-ITEM NAVIGATION GRID ======================= -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/menuGridRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/bottomActionRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/welcomeGroup"
        tools:listitem="@layout/item_menu_card" />

    <!-- ======================= ACTION BUTTONS ======================= -->

    <LinearLayout
        android:id="@+id/bottomActionRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/footerRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLiveTv"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/btn_gold_outline_selector"
            android:fontFamily="sans-serif-medium"
            android:text="LIVE TV"
            android:textColor="@drawable/btn_gold_text_selector"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_live_tv"
            app:iconPadding="8dp"
            app:iconSize="18dp"
            app:iconTint="@drawable/btn_gold_text_selector"
            app:strokeWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMyBookings"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/btn_gold_outline_selector"
            android:fontFamily="sans-serif-medium"
            android:text="MY BOOKINGS"
            android:textColor="@drawable/btn_gold_text_selector"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_calendar_small"
            app:iconPadding="8dp"
            app:iconSize="18dp"
            app:iconTint="@drawable/btn_gold_text_selector"
            app:strokeWidth="0dp" />
    </LinearLayout>

    <!-- FOOTER -->
    <LinearLayout
        android:id="@+id/footerRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/footerGuestInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            tools:text="Guest: Ramya Velu   |   Room: 205" />

        <TextView
            android:id="@+id/footerNavHints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/nav_hint_select"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="   |   "
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/nav_hint_back"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
