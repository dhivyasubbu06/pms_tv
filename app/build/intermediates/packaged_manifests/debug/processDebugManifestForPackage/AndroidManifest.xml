<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pinehotel.hospitality"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="23"
        android:targetSdkVersion="34" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />

    <permission
        android:name="com.pinehotel.hospitality.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.pinehotel.hospitality.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:banner="@drawable/app_banner"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:logo="@drawable/app_banner"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.PineHotelTV"
        android:usesCleartextTraffic="true" >
        <activity
            android:name="com.pinehotel.hospitality.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.PineHotelTV" >
            <intent-filter android:priority="1" >
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.pinehotel.hospitality.SetupActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.PineHotelTV" />

        <!-- Destination activities — stub implementations, wire up real screens later -->
        <activity
            android:name="com.pinehotel.hospitality.ui.LiveTvActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name="com.pinehotel.hospitality.ui.MoviesActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name="com.pinehotel.hospitality.ui.RoomServiceActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name="com.pinehotel.hospitality.ui.HousekeepingActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name="com.pinehotel.hospitality.ui.HotelInfoActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name="com.pinehotel.hospitality.ui.WifiActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name="com.pinehotel.hospitality.ui.GalleryActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name="com.pinehotel.hospitality.ui.MessagesActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name="com.pinehotel.hospitality.ui.SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name="com.pinehotel.hospitality.ui.BookingActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name="com.pinehotel.hospitality.activities.ServicesActivity"
            android:exported="true"
            android:screenOrientation="landscape" />
        <activity
            android:name="com.pinehotel.hospitality.ui.LauncherPinkActivity"
            android:exported="true"
            android:screenOrientation="landscape" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.pinehotel.hospitality.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <uses-library
            android:name="androidx.window.extensions"
            android:required="false" />
        <uses-library
            android:name="androidx.window.sidecar"
            android:required="false" />

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>